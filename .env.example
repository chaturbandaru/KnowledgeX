# Copy this file to .env and fill in real values.
# The backend loads these from a .env file in the project root (see backend/core/config.py).

# ==================== Database ====================
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
DATABASE_NAME=knoweldge_debt

# ==================== JWT / Auth ====================
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== Application ====================
APP_NAME=Knowledge Debt Exchange
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ==================== OpenRouter (LLM + embeddings) ====================
OPENROUTER_API_KEY=your_openrouter_api_key

# Embedding configuration
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSION=1536

# LLM configuration
LLM_PROVIDER=openrouter
LLM_MODEL=google/gemma-3-27b-it:free
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1000

# ==================== Optional: Token Company compression ====================
# Requires `pip install tokenc`. Leave unset to disable.
# TTC_API_KEY=your_token_company_key
